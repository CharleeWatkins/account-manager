Account:
    Balance
    Outgoing_Transaction_History     
    Total_Outgoing_Transactions      
    Total_Outgoing_Transaction_Amount 
    Average_Transaction_Size         

//Checking the transaction rules
START
1. Receive: Account, Amount, Transaction_Type, Current_Timestamp

2. Check if the account has enough money.
   IF Amount > Account.Balance THEN
       RETURN "FAIL: Insufficient funds"
   END IF

3. Check the rapid outgoing transaction rule.
   IF Transaction_Type = "WITHDRAWAL" OR Transaction_Type = "TRANSFER" THEN

       Count = 0
       FOR each T in Account.Outgoing_Transaction_History:
           IF (Current_Timestamp - T.Timestamp) <= 10 THEN
               Count = Count + 1
           END IF
       END FOR

       IF Count >= 3 THEN
           RETURN "FAIL: Too many transactions in 10 seconds"
       END IF
   END IF

4. Check the unusual spending rule.
   IF Account.Total_Outgoing_Transactions > 0 THEN

       Average_Transaction_Size =
           Account.Total_Outgoing_Transaction_Amount
           / Account.Total_Outgoing_Transactions

       Spike_Threshold = 5 × Average_Transaction_Size

       IF Amount > Spike_Threshold THEN
           RETURN "FAIL: Transaction amount is too large"
       END IF
   END IF

5. If none of the rules are blocking the transaction:
   RETURN "PASS"
END

//Updating the account information
START
1. Receive: Account, Amount, Transaction_Type, Current_Timestamp

2. IF Transaction_Type != "WITHDRAWAL" AND Transaction_Type != "TRANSFER" THEN
       STOP
   END IF

3. Add {Amount, Transaction_Type, Current_Timestamp}
   to Account.Outgoing_Transaction_History.

4. Increase Account.Total_Outgoing_Transactions by 1.

5. Add Amount to Account.Total_Outgoing_Transaction_Amount.

6. Calculate the new average:
   Account.Average_Transaction_Size =
       Account.Total_Outgoing_Transaction_Amount / Account.Total_Outgoing_Transactions
END


//The Deposit Part
START
1. Find the user's Account.
   IF Account does not exist THEN
       Display "FAIL: Account not found"
       STOP
   END IF

2. Receive Deposit_Amount.

3. Check that the deposit is greater than 0.
   IF Deposit_Amount <= 0 THEN
       Display "FAIL: Deposit amount must be greater than 0"
       STOP
   END IF

4. Add Deposit_Amount to Account.Balance.

5. Record the successful deposit.

6. Display "Deposit successful."
7. Display the new Account.Balance.
END

//The Withdraw Part
START
1. Find the user's Account.
   IF Account does not exist THEN
       Display "FAIL: Account not found"
       STOP
   END IF

2. Receive Withdrawal_Amount.
3. Receive Current_Timestamp.

4. Check that the withdrawal amount is greater than 0.
   IF Withdrawal_Amount <= 0 THEN
       Display "FAIL: Withdrawal amount must be greater than 0"
       STOP
   END IF

5. Call CHECK TRANSACTION RULES with:
       Account
       Withdrawal_Amount
       "WITHDRAWAL"
       Current_Timestamp

6. Store the result in Rule_Result.

7. IF Rule_Result is not "PASS" THEN
       Record the blocked withdrawal.
       Display Rule_Result.
       STOP
   END IF

8. Subtract Withdrawal_Amount from Account.Balance.

9. Call UPDATE ACCOUNT INFORMATION with:
       Account
       Withdrawal_Amount
       "WITHDRAWAL"
       Current_Timestamp

10. Record the successful withdrawal.
11. Display "Withdrawal successful."
12. Display the new Account.Balance.
END


//The Transfer Part
START
1. Find the Sender_Account.
2. Find the Recipient_Account.

3. Check that the Sender_Account exists.
   IF Sender_Account does not exist THEN
       Display "FAIL: Sender account not found"
       STOP
   END IF

4. Check that the Recipient_Account exists.
   IF Recipient_Account does not exist THEN
       Display "FAIL: Recipient account not found"
       STOP
   END IF

5. Check that the sender and recipient are not the same account.
   IF Sender_Account = Recipient_Account THEN
       Display "FAIL: Cannot transfer to the same account"
       STOP
   END IF

6. Receive Transfer_Amount.
7. Receive Current_Timestamp.

8. Check that the transfer amount is greater than 0.
   IF Transfer_Amount <= 0 THEN
       Display "FAIL: Transfer amount must be greater than 0"
       STOP
   END IF

9. Call CHECK TRANSACTION RULES with:
       Sender_Account
       Transfer_Amount
       "TRANSFER"
       Current_Timestamp

10. Store the result in Rule_Result.

11. IF Rule_Result is not "PASS" THEN
        Record the blocked transfer.
        Display Rule_Result.
        STOP
    END IF

12. Subtract Transfer_Amount from Sender_Account.Balance.
13. Add Transfer_Amount to Recipient_Account.Balance.

14. Call UPDATE ACCOUNT INFORMATION with:
        Sender_Account
        Transfer_Amount
        "TRANSFER"
        Current_Timestamp

15. Record the successful transfer.

16. Display "Transfer successful."
17. Display the new Sender_Account.Balance.
END
